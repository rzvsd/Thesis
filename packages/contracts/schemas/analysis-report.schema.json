{
  "$id": "AnalysisReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "job_id",
    "schema_version",
    "type",
    "generated_at",
    "confidence",
    "sections",
    "flags",
    "data_sources"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deep_dive",
        "market_pulse"
      ]
    },
    "ticker": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "confidence": {
      "$ref": "ConfidenceBlock"
    },
    "signal": {
      "$ref": "ReportSignal"
    },
    "filing_intelligence": {
      "$ref": "FilingIntelligenceBlock"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "ReportSection"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "ConfidenceBlock": {
      "$id": "ConfidenceBlock",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "label",
        "limiting_factors"
      ],
      "properties": {
        "score": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "insufficient_data"
          ]
        },
        "limiting_factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ReportSignal": {
      "$id": "ReportSignal",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reasons",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "positive",
            "neutral",
            "negative",
            "no_signal"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "EvidenceItem"
          }
        }
      }
    },
    "FilingIntelligenceBlock": {
      "$id": "FilingIntelligenceBlock",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "prompt_version",
        "generation_mode",
        "metric_deltas",
        "memo",
        "omissions",
        "evidence"
      ],
      "properties": {
        "prompt_version": { "type": "string" },
        "generation_mode": {
          "type": "string",
          "enum": ["deterministic_fixture", "live_prompt", "fallback"]
        },
        "metric_deltas": { "type": "array" },
        "memo": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "the_filing_read",
            "what_changed",
            "the_good",
            "the_bad",
            "the_interesting",
            "management_tone",
            "risk_watch",
            "plain_english_takeaway",
            "what_to_watch_next"
          ],
          "properties": {
            "the_filing_read": { "type": "string" },
            "what_changed": { "type": "string" },
            "the_good": { "type": "string" },
            "the_bad": { "type": "string" },
            "the_interesting": { "type": "string" },
            "management_tone": { "type": "string" },
            "risk_watch": { "type": "string" },
            "plain_english_takeaway": { "type": "string" },
            "what_to_watch_next": { "type": "string" }
          }
        },
        "omissions": { "type": "array" },
        "evidence": { "type": "array" }
      }
    }
  }
}
