{
  "$id": "AnalysisReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "job_id",
    "schema_version",
    "type",
    "generated_at",
    "confidence",
    "sections",
    "flags",
    "data_sources"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deep_dive",
        "market_pulse"
      ]
    },
    "ticker": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "confidence": {
      "$ref": "ConfidenceBlock"
    },
    "signal": {
      "$ref": "ReportSignal"
    },
    "filing_intelligence": {
      "$ref": "FilingIntelligenceBlock"
    },
    "financial_indicators": {
      "$ref": "FinancialIndicatorsBlock"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "ReportSection"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "ConfidenceBlock": {
      "$id": "ConfidenceBlock",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "label",
        "limiting_factors"
      ],
      "properties": {
        "score": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "insufficient_data"
          ]
        },
        "limiting_factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ReportSignal": {
      "$id": "ReportSignal",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reasons",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "positive",
            "neutral",
            "negative",
            "no_signal"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "EvidenceItem"
          }
        }
      }
    },
    "FilingIntelligenceBlock": {
      "$id": "FilingIntelligenceBlock",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "prompt_version",
        "generation_mode",
        "metric_deltas",
        "memo",
        "omissions",
        "evidence"
      ],
      "properties": {
        "prompt_version": { "type": "string" },
        "generation_mode": {
          "type": "string",
          "enum": ["deterministic_fixture", "live_prompt", "fallback"]
        },
        "metric_deltas": { "type": "array" },
        "memo": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "the_filing_read",
            "what_changed",
            "the_good",
            "the_bad",
            "the_interesting",
            "management_tone",
            "risk_watch",
            "plain_english_takeaway",
            "what_to_watch_next"
          ],
          "properties": {
            "the_filing_read": { "type": "string" },
            "what_changed": { "type": "string" },
            "the_good": { "type": "string" },
            "the_bad": { "type": "string" },
            "the_interesting": { "type": "string" },
            "management_tone": { "type": "string" },
            "risk_watch": { "type": "string" },
            "plain_english_takeaway": { "type": "string" },
            "what_to_watch_next": { "type": "string" }
          }
        },
        "omissions": { "type": "array" },
        "evidence": { "type": "array" }
      }
    },
    "FinancialIndicatorsBlock": {
      "$id": "FinancialIndicatorsBlock",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "prompt_version",
        "period",
        "basis",
        "valuation",
        "profitability",
        "growth",
        "balance_sheet",
        "cash_flow_quality",
        "capital_allocation",
        "five_year_trends",
        "value_classification",
        "plain_english",
        "omissions",
        "evidence"
      ],
      "properties": {
        "prompt_version": { "type": "string" },
        "period": { "type": "string" },
        "basis": { "type": "string", "enum": ["ttm", "annual", "mixed"] },
        "valuation": { "type": "array" },
        "profitability": { "type": "array" },
        "growth": { "type": "array" },
        "balance_sheet": { "type": "array" },
        "cash_flow_quality": { "type": "array" },
        "capital_allocation": { "type": "array" },
        "five_year_trends": { "type": "array" },
        "value_classification": {
          "type": "object",
          "additionalProperties": true,
          "required": ["classification", "confidence", "reasons", "trap_warnings"],
          "properties": {
            "classification": {
              "type": "string",
              "enum": [
                "classic_value",
                "quality_value",
                "quality_growth",
                "expensive_growth",
                "turnaround",
                "distressed",
                "value_trap_risk",
                "insufficient_data"
              ]
            },
            "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
            "reasons": { "type": "array", "items": { "type": "string" } },
            "trap_warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "plain_english": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "value_lens",
            "business_quality",
            "balance_sheet_read",
            "cash_flow_read",
            "five_year_read",
            "plain_english_takeaway",
            "what_to_watch_next"
          ],
          "properties": {
            "value_lens": { "type": "string" },
            "business_quality": { "type": "string" },
            "balance_sheet_read": { "type": "string" },
            "cash_flow_read": { "type": "string" },
            "five_year_read": { "type": "string" },
            "plain_english_takeaway": { "type": "string" },
            "what_to_watch_next": { "type": "string" }
          }
        },
        "omissions": { "type": "array" },
        "evidence": { "type": "array" }
      }
    }
  }
}
