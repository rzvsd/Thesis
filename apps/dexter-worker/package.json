{
  "name": "@thesis/dexter-worker",
  "private": true,
  "version": "0.1.0",
  "main": "dist/apps/dexter-worker/src/server.js",
  "types": "dist/apps/dexter-worker/src/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && DEXTER_FACT_PACK=off node --test dist/apps/dexter-worker/tests/health.test.js dist/apps/dexter-worker/tests/pipeline.test.js dist/apps/dexter-worker/tests/server.test.js dist/apps/dexter-worker/tests/pulse-brief.test.js dist/apps/dexter-worker/tests/m5-acceptance.test.js dist/apps/dexter-worker/tests/m2-comparisons.test.js dist/apps/dexter-worker/tests/m3-value-discipline.test.js dist/apps/dexter-worker/tests/m4-authoring.test.js dist/apps/dexter-worker/tests/financial-indicators.test.js dist/apps/dexter-worker/tests/m1-contract-schema.test.js dist/apps/dexter-worker/tests/tools/tool-runner.test.js dist/apps/dexter-worker/tests/tools/tool-policy.test.js dist/apps/dexter-worker/tests/tools/financial-analysis-tool.test.js dist/apps/dexter-worker/tests/tools/evidence-debate-tool.test.js dist/apps/dexter-worker/tests/tools/recent-context-tool.test.js dist/apps/dexter-worker/tests/fact-pack/mapping.test.js dist/apps/dexter-worker/tests/fact-pack/build.test.js dist/apps/dexter-worker/tests/fact-pack/splits.test.js dist/apps/dexter-worker/tests/fact-pack/pipeline-fact-pack.test.js",
    "eval:m1": "tsc -p tsconfig.json && node scripts/m1-eval-pack.mjs",
    "langsmith:push-prompts": "node scripts/sync-langsmith-prompts.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.22.0",
    "@thesis/contracts": "workspace:*",
    "@thesis/observability": "workspace:*",
    "langsmith": "^0.5.19",
    "redis": "^4.7.1"
  }
}
