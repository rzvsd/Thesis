{
  "name": "thesis-fintech",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test && python tests/integration/test_m2_data_plane_endpoints.py && python tests/integration/test_m3_dexter_worker.py && python tests/integration/test_m4_product_api.py && python tests/integration/test_m6_market_pulse.py",
    "security:audit": "corepack pnpm audit --audit-level critical --ignore-registry-errors",
    "security:sast": "node scripts/security/sast-baseline.mjs",
    "security:ci": "corepack pnpm run security:audit && corepack pnpm run security:sast",
    "phase6:m0:inventory": "node scripts/phase6/deprecated-dependency-guard.mjs --inventory",
    "phase6:m0:guard": "node scripts/phase6/deprecated-dependency-guard.mjs",
    "phase6:m0:self-test": "node scripts/phase6/deprecated-dependency-guard.mjs --self-test",
    "phase6:m0:write-baseline": "node scripts/phase6/deprecated-dependency-guard.mjs --write-baseline",
    "phase6:m5:dependency-scan": "node scripts/phase6/m5-core-dependency-scan.mjs",
    "m0:build-universe": "python scripts/historical/build_sp500_universe.py",
    "m0:load": "python scripts/historical/run_m0_load.py",
    "test:e2e": "corepack pnpm --filter @thesis/product-api build && python tests/e2e/test_m4_core_flows.py",
    "test:load": "corepack pnpm --filter @thesis/product-api build && python tests/load/run_m4_load.py",
    "qa:maestro:prepare": "node qa/maestro/scripts/prepare.mjs",
    "qa:maestro:smoke": "node qa/maestro/scripts/run-smoke.mjs",
    "runbooks:m4:smoke": "powershell -ExecutionPolicy Bypass -File scripts/runbooks/smoke-m4-ops.ps1",
    "runbooks:m5:smoke": "powershell -ExecutionPolicy Bypass -File scripts/runbooks/smoke-m5-launch-gate.ps1",
    "runbooks:m9:smoke": "powershell -ExecutionPolicy Bypass -File scripts/runbooks/smoke-hardening.ps1",
    "runbooks:m9:smoke:backup": "powershell -ExecutionPolicy Bypass -File scripts/runbooks/smoke-hardening.ps1 -RunBackupRestore"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "pnpm": {
    "overrides": {
      "@tootallnate/once": "3.0.1",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=5.0.0 <5.0.5": "5.0.5",
      "flatted": "3.4.2",
      "langsmith": "0.5.19",
      "node-forge": "1.4.0",
      "picomatch": "4.0.4",
      "protobufjs": "7.5.5",
      "websocket-driver@<0.7.5": "0.7.5"
    }
  }
}
