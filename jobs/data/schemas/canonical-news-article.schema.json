{
  "$id": "CanonicalNewsArticle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "article_id",
    "source",
    "url",
    "title",
    "published_at",
    "retrieved_at",
    "body_text",
    "tickers_mentioned",
    "is_approved_source"
  ],
  "properties": {
    "article_id": { "type": "string" },
    "source": { "type": "string" },
    "url": { "type": "string" },
    "title": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "body_text": { "type": "string" },
    "tickers_mentioned": {
      "type": "array",
      "items": { "type": "string" }
    },
    "is_approved_source": { "type": "boolean" }
  }
}
