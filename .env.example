# Root project name used by local Docker Compose.
COMPOSE_PROJECT_NAME=thesis-fintech

# Shared runtime environment for all M1 stub services.
NODE_ENV=development
LOG_LEVEL=info

# Python runtime expected for M2 data-plane services.
PYTHON_VERSION=3.11

# Port for the placeholder mobile shell health service.
MOBILE_PORT=3006

# Port for the public Product API stub.
PRODUCT_API_PORT=3001

# Port for the Dexter worker stub.
DEXTER_WORKER_PORT=3002

# Port for the OpenBB data service stub.
DATA_OPENBB_PORT=3003

# Port for the news ingestion stub.
NEWS_INGEST_PORT=3004

# Port for the scheduler stub.
SCHEDULER_PORT=3005

# Redis connection used by M2 data-plane rate limiting.
# In production, set REDIS_PASSWORD and include it in REDIS_URL
# (for example: redis://:strong-password@redis:6379/0).
REDIS_URL=redis://redis:6379/0
REDIS_JOB_QUEUE_KEY=jobs:deep_dive
REDIS_PASSWORD=
REDIS_BIND_HOST=127.0.0.1
POSTGRES_BIND_HOST=127.0.0.1

# M4 persistence and queue backends.
STORE_BACKEND=postgres
QUEUE_BACKEND=redis
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thesis
DATABASE_URL_DOCKER=postgres://postgres:postgres@postgres:5432/thesis
AUTO_MIGRATE=true
ARTIFACT_ROOT=/app/data/artifacts
JOB_RECOVERY_ENABLED=true
JOB_RECOVERY_RUN_ON_STARTUP=true
JOB_RECOVERY_INTERVAL_SECONDS=30
JOB_RECOVERY_BATCH_SIZE=100
JOB_RECOVERY_QUEUED_STALE_SECONDS=20
JOB_RECOVERY_RUNNING_TIMEOUT_SECONDS=180
JOB_RECOVERY_REQUEUE_COOLDOWN_SECONDS=60

# M4 auth and token lifecycle defaults.
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_WORKER_TOKEN=dev-internal-worker-token
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
MAX_JSON_BODY_BYTES=1048576
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
VERIFICATION_TOKEN_TTL_SECONDS=86400
AUTH_EXPOSE_VERIFICATION_TOKEN=true
# Local-only admin bootstrap. This is ignored when NODE_ENV=production.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
ADMIN_BOOTSTRAP_AUTO_VERIFY=true
ADMIN_BOOTSTRAP_FORCE_PRO=true
SENTRY_DSN=
BCRYPT_COST=12
SUBSCRIPTION_TIMEZONE=America/New_York
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_PUBLIC_ANDROID_KEY=
REVENUECAT_SERVER_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=

# M2 fixture/mock-first mode. Live-provider validation stays blocked until keys and
# the real OpenBB fork pin are documented.
DATA_OPENBB_FIXTURE_MODE=true
NEWS_INGEST_FIXTURE_MODE=true
DEXTER_FIXTURE_MODE=true

# Provider API keys for M2. Leave blank in local fixture mode.
FMP_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

# M3 Dexter runtime configuration. Fixture mode is the default for deterministic CI.
DEXTER_MODEL=
DEXTER_BUN_BIN=bun
DEXTER_AGENT_MAX_ITERATIONS=2
DEXTER_MAX_PARALLEL_SECTIONS=4
DEXTER_SECTION_TIMEOUT_MS=70000
DEXTER_RETRY_SECTION_TIMEOUT_MS=15000
DEXTER_RETRY_BACKOFF_MS=500
DEXTER_MAX_SECTION_RETRIES=0
DEXTER_MIN_SCORED_CLAIM_EVIDENCE_COUNT=1
DEXTER_MIN_SIGNAL_EVIDENCE_COUNT=2
DEXTER_SIMULATE_TIMEOUT_SECTION=
DEXTER_FORCE_FAIL_TICKERS=FAILME,BADTICKERZZZ

# M3 Deep Dive provider and observability secrets. Leave blank in fixture mode.
ANTHROPIC_API_KEY=
FINANCIAL_DATASETS_API_KEY=
EXASEARCH_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# M4 worker queue consumption mode.
DEXTER_QUEUE_MODE=true
DEXTER_QUEUE_BLOCK_TIMEOUT_SECONDS=5
PRODUCT_API_INTERNAL_BASE_URL=http://product-api:3001

# M6 Market Pulse scheduler and pipeline defaults.
SCHEDULER_TIMEZONE=America/New_York
SCHEDULER_DELIVERY_TIME_LOCAL=06:30
SCHEDULER_SENTIMENT_TIME_LOCAL=18:00
SCHEDULER_TEST_MODE=false
SCHEDULER_TEST_FIRE_IN_SECONDS=120
MARKET_PULSE_DATA_OPENBB_BASE_URL=http://data-openbb:3003
MARKET_PULSE_NEWS_INGEST_BASE_URL=http://news-ingest:3004
MARKET_PULSE_TICKERS=AAPL,MSFT,TSLA
MARKET_PULSE_SCHEMA_VERSION=1.0.0
SENTIMENT_SCHEMA_VERSION=1.0.0
SENTIMENT_YAHOO_BASE_URL=https://query1.finance.yahoo.com
SENTIMENT_FRED_BASE_URL=https://api.stlouisfed.org/fred
SENTIMENT_FRED_API_KEY=
SENTIMENT_BREADTH_UNIVERSE_LIMIT=500
SENTIMENT_BREADTH_CONCURRENCY=8
SENTIMENT_MIN_AVAILABLE_INPUTS=3

# M6 push delivery strategy (single durable token per user in users.device_token).
PUSH_PROVIDER_MODE=stub
# Local (non-container) credential path for Firebase Admin SDK.
GOOGLE_APPLICATION_CREDENTIALS=

# M5 ticker registry sync defaults (official Nasdaq Trader feeds).
TICKER_SYNC_MODE=full_then_delta
TICKER_AUTO_SYNC_ENABLED=true
TICKER_AUTO_SYNC_RUN_ON_STARTUP=true
TICKER_DELTA_SYNC_INTERVAL_SECONDS=900
TICKER_FULL_SYNC_INTERVAL_SECONDS=86400
TICKER_FULL_NASDAQ_URL=https://www.nasdaqtrader.com/dynamic/SymDir/nasdaqlisted.txt
TICKER_FULL_OTHER_URL=https://www.nasdaqtrader.com/dynamic/SymDir/otherlisted.txt
TICKER_DAILY_DELTA_SOURCE=trading_system_adds_deletes
TICKER_DAILY_DELTA_URL=https://www.nasdaqtrader.com/dynamic/SymDir/TradingSystemAddsDeletes.txt
TICKER_DAILY_DELTA_FILE=
TICKER_FULL_NASDAQ_FILE=
TICKER_FULL_OTHER_FILE=
TICKER_ALLOW_FILE_INPUTS=false

# Redis-backed provider rate limiting defaults for M2.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_BURST_ALLOWANCE=2
RATE_LIMIT_COOLDOWN_SECONDS=60
NEWS_SOURCE_RATE_LIMIT_PER_MINUTE=5
FMP_FINANCE_RATE_LIMIT_PER_MINUTE=10
FMP_MACRO_RATE_LIMIT_PER_MINUTE=5
POLYGON_RATE_LIMIT_PER_MINUTE=5
ALPHA_VANTAGE_RATE_LIMIT_PER_MINUTE=5

# M0 historical bulk-load defaults (SEC + HuggingFace).
SEC_USER_AGENT=ThesisFinance admin@yourdomain.com
M0_SEC_COMPANYFACTS_ZIP_URL=https://www.sec.gov/Archives/edgar/daily-index/xbrl/companyfacts.zip
M0_SEC_COMPANY_TICKERS_URL=https://www.sec.gov/files/company_tickers.json
M0_HF_DATASET_ID=kurry/sp500_earnings_transcripts
M0_HF_REVISION=f3ded372da8d18dc6ad98955c4558e34b5fe6d45
M0_TRANSCRIPT_MIN_YEAR=2019
M0_EXPECTED_HF_ROWS=33362
