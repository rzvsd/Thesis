# Root project name used by local Docker Compose.
COMPOSE_PROJECT_NAME=thesis-fintech

# Shared runtime environment for all M1 stub services.
NODE_ENV=development
LOG_LEVEL=info

# Port for the placeholder mobile shell health service.
MOBILE_PORT=3006

# Port for the public Product API stub.
PRODUCT_API_PORT=3001

# Port for the Dexter worker stub.
DEXTER_WORKER_PORT=3002

# Port for the OpenBB data service stub.
DATA_OPENBB_PORT=3003

# Port for the news ingestion stub.
NEWS_INGEST_PORT=3004

# Port for the scheduler stub.
SCHEDULER_PORT=3005
